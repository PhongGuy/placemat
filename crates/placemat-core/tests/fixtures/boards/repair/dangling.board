placemat-board version=0

rect "a1Xq" {
    at 100 100
    seed 1
    size 200 100
    fill none
    stroke "#1e1e1e" width=2 roughness=1 dash=solid
    z "a1"
}

widget "w1" {
    colour "#ff0000"
}

arrow "k4Ar" {
    from "b7Kp" x=0.5 y=0.5
    seed 2
    to 1000 100
    head start=none end=arrow
    stroke "#1e1e1e" width=2 roughness=1 dash=solid
    z "a2"
}

arrow "m2Zz" {
    from "a1Xq" x=1 y=0.5
    seed 3
    to "gone" x=0 y=0
    head start=none end=arrow
    stroke "#1e1e1e" width=2 roughness=1 dash=solid
    z "a3"
}

arrow "n3Yy" {
    from "x" x=0 y=0
    seed 4
    to "y" x=1 y=1
    head start=none end=arrow
    stroke "#1e1e1e" width=2 roughness=1 dash=solid
    z "a4"
}

arrow "p5Ww" {
    from "w1" x=0 y=0
    seed 5
    to "a1Xq" x=0 y=1
    head start=none end=arrow
    stroke "#1e1e1e" width=2 roughness=1 dash=solid
    z "a5"
}
